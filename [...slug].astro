---
import Base from '../../layouts/Base.astro';
import PRNotice from '../../components/PRNotice.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const cat = CATEGORIES.find((c) => c.id === d.category)?.label ?? '';
const fmt = (x: Date) => x.toISOString().slice(0, 10).replaceAll('-', '.');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: `${SITE.url}/articles/${entry.slug}`,
};
---
<Base title={d.title} description={d.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <p class="crumb"><a href="/">トップ</a> ＞ <a href={`/articles?c=${d.category}`}>{cat}</a></p>
  <article class="post">
    {d.pr && <PRNotice />}
    <h1 class="hand">{d.title}</h1>
    <p class="meta">公開：{fmt(d.publishedAt)}{d.updatedAt && `／更新：${fmt(d.updatedAt)}`}</p>
    <Content />
    <div class="author">
      <img src="/images/sumimaru.png" alt="すみまるのイラスト" width="56" height="56" />
      <div><b>この記事を書いた人：{SITE.author}</b><br />
        <span class="meta">夫婦で世界一周20か国。路上書道と、海外の準備について書いています。</span></div>
    </div>
    <p class="meta">※料金や制度は変わることがあります。申し込み前に必ず公式サイトで最新情報を確認してください。</p>
  </article>
</Base>
