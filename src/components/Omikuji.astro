---
// 猫のおみくじ「今日の旅運」。日付で結果が決まる（同じ日は同じ結果）。個人情報・追跡なし。
const FORTUNES = [
  { rank: '大吉', msg: 'カードも現金も、両方そろえて出かけたくなる日。「あれ、使えない…」に備えておくと安心です。', slug: 'cash-card-by-country', link: 'カードが使えない場面まとめ' },
  { rank: '中吉', msg: '出発前に、保険の補償が始まる条件を見直すのにいい日。「利用付帯」の意味を確認しておくと安心です。', slug: 'travel-insurance-card-kl', link: 'カード付帯の保険の話' },
  { rank: '吉', msg: '着いてすぐ慌てないように、通信の準備を先に済ませておくといい日です。', slug: 'esim-sekaiisshu', link: 'eSIMの料金の話' },
  { rank: '吉', msg: '配車アプリは、乗る前に料金を確認。メモしておくと、あとで自分も助かります。', slug: 'indrive-nepal-danang', link: 'InDriveの使い方' },
  { rank: '小吉', msg: '空港から街までの行き方は、前の日に調べておくと気持ちが楽になる日。', slug: 'uzbekistan-airport-city', link: 'タシケント空港から市内へ' },
  { rank: '末吉', msg: '「行けたらいいな」くらいの気持ちでも、大丈夫。一歩目は、ゆっくりで。', slug: 'hajimemashite', link: 'はじめましての記事' },
] as const;
---
<section class="omikuji" aria-label="猫のおみくじ">
  <h2 class="sec-title hand">猫のおみくじ「今日の旅運」</h2>
  <div class="omikuji-box" id="omikuji" data-fortunes={JSON.stringify(FORTUNES)}>
    <button type="button" class="mini-btn" id="omikuji-btn">🐱 おみくじをひく</button>
    <div id="omikuji-result" class="omikuji-result" aria-live="polite" hidden>
      <p class="omikuji-rank hand" id="omikuji-rank"></p>
      <p id="omikuji-msg"></p>
      <p class="meta"><a id="omikuji-link" href="/"></a></p>
      <a class="mini-btn" id="omikuji-x" target="_blank" rel="noopener">Xでシェアする</a>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var box = document.getElementById('omikuji');
    if (!box) return;
    var list = JSON.parse(box.getAttribute('data-fortunes'));
    var btn = document.getElementById('omikuji-btn'), res = document.getElementById('omikuji-result');
    var d = new Date(), key = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    var h = 0; for (var i = 0; i < key.length; i++) h = (h * 31 + key.charCodeAt(i)) % 100003;
    var f = list[h % list.length];
    function show() {
      document.getElementById('omikuji-rank').textContent = '今日の旅運：' + f.rank;
      document.getElementById('omikuji-msg').textContent = f.msg;
      var a = document.getElementById('omikuji-link'); a.href = '/articles/' + f.slug; a.textContent = '▶ ' + f.link;
      var text = '猫のおみくじ「今日の旅運」は【' + f.rank + '】でした🐱\n' + f.msg;
      document.getElementById('omikuji-x').href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text) + '&url=' + encodeURIComponent(location.origin + '/');
      res.hidden = false; btn.hidden = true;
    }
    var shown = false;
    try { shown = localStorage.getItem('omikuji:' + key) === '1'; } catch (e) {}
    if (shown) show();
    btn.addEventListener('click', function () {
      show(); try { localStorage.setItem('omikuji:' + key, '1'); } catch (e) {}
    });
  })();
</script>
