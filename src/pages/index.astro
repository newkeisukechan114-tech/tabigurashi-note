---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES } from '../data/site';

const all = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latest = all.slice(0, 6);
const label = (id: string) => CATEGORIES.find((c) => c.id === id)?.label ?? '';
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---
<Base>
  <section class="hero">
    <p class="en hand">{SITE.nameEn}</p>
    <h1 class="hand">海外に行く前に知りたいことを、<br />実際に歩いた人の言葉で。</h1>
    <p>夫婦で世界一周20カ国。旅先で続けた路上書道の話と、海外に行く前の準備（お金、通信、持ち物）を、体験をもとに書いています。</p>
    <a class="btn" href="/articles">記事一覧を見る</a>
  </section>

  <h2 class="sec-title hand">テーマから探す</h2>
  <div class="grid">
    {CATEGORIES.map((c) => (
      <div class="card"><span class="tag">{c.label}</span>
        <h3><a href={`/articles?c=${c.id}`}>{c.label}の記事</a></h3>
      </div>
    ))}
  </div>

  <h2 class="sec-title hand">新着記事</h2>
  {latest.length === 0 ? (
    <div class="empty">記事を準備中です。しばらくお待ちください。</div>
  ) : (
    <div class="grid">
      {latest.map((a) => (
        <div class="card">
          <span class="tag">{label(a.data.category)}</span>
          <h3><a href={`/articles/${a.slug}`}>{a.data.title}</a></h3>
          <p class="meta">{fmt(a.data.publishedAt)} 公開</p>
        </div>
      ))}
    </div>
  )}

  <div class="author">
    <img src="/images/sumimaru.png" alt="すみまるのイラスト" width="56" height="56" />
    <div><b>運営者：{SITE.author}</b><br />
      <span class="meta">夫婦で世界一周20カ国。<a href="/about">くわしく見る</a></span></div>
  </div>
</Base>
